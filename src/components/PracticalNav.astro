---
import { practicalLinks } from '../data/practical'
---

<nav class="practical-nav" aria-label="Rubriques pratiques">
  {practicalLinks.map((link) => (
    <a href={link.href}>
      <i class={`ph ph-${link.icon}`} aria-hidden="true"></i>
      <span><strong>{link.label}</strong><small>{link.description}</small></span>
      <i class="ph ph-arrow-right" aria-hidden="true"></i>
    </a>
  ))}
</nav>
