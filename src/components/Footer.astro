---
import { readSiteOrigin } from '../lib/site-origin'
const launchCandidate = readSiteOrigin() !== null
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div>
      <p class="site-footer__brand">Ludo</p>
      <p>Pâquis · Sécheron</p>
      <p class="site-footer__note">Un lieu pour jouer, découvrir et partager à Genève.</p>
    </div>
    <div>
      <h2>Nous trouver</h2>
      <a href="/paquis">Pâquis · horaires et accès</a>
      <a href="/secheron">Sécheron · horaires et accès</a>
      <a href="/infos-pratiques">Toutes les infos pratiques</a>
    </div>
    <div>
      <h2>Découvrir</h2>
      <a href="/actualites">Actualités</a>
      <a href="/activites">Activités</a>
      <a href="/top-3">Top 3 des jeux</a>
      <a href="/galerie">Galerie</a>
    </div>
    <div>
      <h2>Infos pratiques</h2>
      <a href="/infos-pratiques/fonctionnement">Fonctionnement</a>
      <a href="/infos-pratiques/inscription">S’inscrire</a>
      <a href="/infos-pratiques/faq">Questions fréquentes</a>
      <a href="/infos-pratiques/annuaire">Annuaire</a>
    </div>
    <div>
      <h2>L’association</h2>
      <a href="/association/mission">Notre mission</a>
      <a href="/association/equipe">L’équipe</a>
      <a href="/association/comite">Le comité</a>
      <a href="/association/comite#rapports">Rapports d’activité</a>
      <a href="/association/documents">Tous les documents</a>
      <a href="/contact">Nous contacter</a>
    </div>
  </div>
  <div class="shell site-footer__bottom">
    {!launchCandidate && <span>Prototype de travail — informations à confirmer</span>}
    <span>Association de la Ludothèque de Pâquis-Sécheron</span>
  </div>
</footer>
