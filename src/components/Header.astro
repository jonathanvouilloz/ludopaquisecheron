---
import { discoverNavigation, primaryNavigation } from '../data/site'

interface Props {
  activePath?: string
}

const { activePath = '/' } = Astro.props
const isDiscoverPath = discoverNavigation.some((item) => activePath.startsWith(item.href))
const isActive = (href: string) => href === '/actualites'
  ? isDiscoverPath
  : activePath.startsWith(href)
---

<header class="site-header" data-site-header>
  <div class="site-header__inner shell">
    <a class="wordmark" href="/" aria-label="Ludothèque Pâquis-Sécheron — Accueil">
      <img class="wordmark__logo" src="/images/logo-paquis-secheron.gif" alt="" width="400" height="300" decoding="async" />
      <span><strong>Ludo</strong><small>Pâquis · Sécheron</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {primaryNavigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          <i class={`ph ph-${item.icon}`} aria-hidden="true"></i><span>{item.label}</span>
        </a>
      ))}
    </nav>

    <a class="button button--brand header-contact" href="/contact#contact-direct" aria-label="Contacter la ludothèque directement"><i class="ph ph-phone" aria-hidden="true"></i><span>Contacter la ludothèque</span></a>

    <details class="mobile-menu">
      <summary aria-label="Ouvrir le menu"><i class="ph ph-list" aria-hidden="true"></i></summary>
      <nav aria-label="Navigation mobile">
        {primaryNavigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <i class={`ph ph-${item.icon}`} aria-hidden="true"></i>{item.label}
          </a>
        ))}
        <a class="button button--brand" href="/contact#contact-direct"><i class="ph ph-phone" aria-hidden="true"></i>Contacter la ludothèque</a>
      </nav>
    </details>
  </div>
</header>

<script>
  let cleanupHeader: (() => void) | undefined
  const initializeHeader = () => {
    cleanupHeader?.()
    const header = document.querySelector<HTMLElement>('[data-site-header]')
    if (!header) return
    const mobileMenu = header.querySelector<HTMLDetailsElement>('.mobile-menu')
    const controller = new AbortController()
    let lastY = window.scrollY
    let frame = 0
    const updateHeader = () => {
      if (frame) return
      frame = window.requestAnimationFrame(() => {
        const currentY = window.scrollY
        const delta = currentY - lastY
        const menuIsOpen = mobileMenu?.open === true

        header.classList.toggle('site-header--scrolled', currentY > 24)

        if (currentY < 96 || delta < -4 || menuIsOpen || header.contains(document.activeElement)) {
          header.classList.remove('site-header--hidden')
        } else if (delta > 4) {
          header.classList.add('site-header--hidden')
        }

        if (Math.abs(delta) > 4) lastY = currentY
        frame = 0
      })
    }
    window.addEventListener('scroll', updateHeader, { passive: true, signal: controller.signal })

    mobileMenu?.addEventListener('toggle', () => {
      if (mobileMenu.open) header.classList.remove('site-header--hidden')
    }, { signal: controller.signal })
    mobileMenu?.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) mobileMenu.open = false
    }, { signal: controller.signal })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileMenu?.open) {
        mobileMenu.open = false
        mobileMenu.querySelector('summary')?.focus()
      }
    }, { signal: controller.signal })
    cleanupHeader = () => {
      controller.abort()
      if (frame) window.cancelAnimationFrame(frame)
    }
    updateHeader()
  }
  initializeHeader()
  document.addEventListener('astro:page-load', initializeHeader)
  document.addEventListener('astro:before-swap', () => cleanupHeader?.())
</script>
