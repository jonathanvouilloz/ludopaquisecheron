---
import type { PublicPdfAttachment, PublicSupportImage } from '../../lib/ludohub'

type Props = {
  body: string[]
  supportImage: PublicSupportImage | null
  supportImages?: PublicSupportImage[]
  attachments: PublicPdfAttachment[]
}

const { body, supportImage, supportImages, attachments } = Astro.props
const images = supportImages?.length ? supportImages : supportImage ? [supportImage] : []
const formatSize = (sizeBytes: number) => {
  const megabytes = sizeBytes / (1024 * 1024)
  return megabytes >= 1
    ? `${megabytes.toLocaleString('fr-CH', { maximumFractionDigits: 1 })} Mo`
    : `${Math.ceil(sizeBytes / 1024).toLocaleString('fr-CH')} Ko`
}
---

{body.map((block) => <div class="editorial-rich-block" set:html={block} />)}

{images.map((image) => (
  <figure class="support-figure">
    <img src={image.url} alt={image.alt} loading="lazy" decoding="async" />
    {(image.caption || image.credit) && (
      <figcaption>
        {image.caption && <span>{image.caption}</span>}
        {image.credit && <small>Photo : {image.credit}</small>}
      </figcaption>
    )}
  </figure>
))}

{attachments.length > 0 && (
  <section class="attachments" aria-labelledby="attachments-title">
    <h2 id="attachments-title">Documents à consulter</h2>
    <ul>
      {attachments.map((attachment) => (
        <li>
          <i class="ph ph-file-pdf attachment-icon" aria-hidden="true"></i>
          <div class="attachment-copy">
            <strong>{attachment.title}</strong>
            <span>{attachment.fileName} · {formatSize(attachment.sizeBytes)}</span>
          </div>
          <div class="attachment-actions">
            <a href={attachment.viewUrl} target="_blank" rel="noopener noreferrer">
              Ouvrir<span class="sr-only"> {attachment.title}</span>
            </a>
            <a href={attachment.downloadUrl} download>
              Télécharger<span class="sr-only"> {attachment.title}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .editorial-rich-block { color: var(--color-ink-muted); font-size: var(--text-body-lg); }
  .editorial-rich-block + .editorial-rich-block { margin-top: var(--space-4); }
  .editorial-rich-block :global(p) { margin-block: 0 var(--space-4); }
  .editorial-rich-block :global(h2), .editorial-rich-block :global(h3), .editorial-rich-block :global(h4) { margin-block: var(--space-6) var(--space-3); color: var(--color-brand-dark); font-family: var(--font-ui); line-height: 1.2; }
  .editorial-rich-block :global(h2) { font-size: var(--text-heading-lg); }
  .editorial-rich-block :global(h3), .editorial-rich-block :global(h4) { font-size: var(--text-heading-md); }
  .editorial-rich-block :global(ul), .editorial-rich-block :global(ol) { display: grid; gap: var(--space-2); margin-block: 0 var(--space-5); padding-left: var(--space-6); }
  .editorial-rich-block :global(blockquote) { margin: var(--space-5) 0; padding: var(--space-4) var(--space-5); border-left: 5px solid var(--color-highlight); border-radius: var(--radius-xs); background: var(--color-surface); }
  .editorial-rich-block :global(blockquote p) { margin: 0; }
  .editorial-rich-block :global(a) { color: var(--color-brand-dark); font-weight: 700; text-underline-offset: .2em; }
  .support-figure { margin: var(--space-6) 0; }
  .support-figure img { width: 100%; max-height: 36rem; border-radius: var(--radius-lg); object-fit: cover; }
  .support-figure figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-4); margin-top: var(--space-2); color: var(--color-ink-muted); font-size: .85rem; }
  .support-figure small { font: inherit; }
  .attachments { margin-top: var(--space-7); padding-top: var(--space-6); border-top: 2px solid var(--color-border); }
  .attachments h2 { margin: 0 0 var(--space-4); color: var(--color-brand-dark); font-family: var(--font-ui); font-size: var(--text-heading-md); }
  .attachments ul { display: grid; gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
  .attachments li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--space-3); align-items: center; padding: var(--space-4); border: 2px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .attachment-icon { color: var(--color-accent); font-size: 1.75rem; }
  .attachment-copy { display: grid; gap: var(--space-1); min-width: 0; }
  .attachment-copy strong { color: var(--color-ink); }
  .attachment-copy span { overflow-wrap: anywhere; color: var(--color-ink-muted); font-size: .85rem; }
  .attachment-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .attachment-actions a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: var(--space-3); border-radius: var(--radius-pill); color: var(--color-brand-dark); font-family: var(--font-ui); font-size: .88rem; font-weight: 700; }
  .attachment-actions a:hover { background: var(--color-brand-soft); }
  @media (max-width: 620px) {
    .attachments li { grid-template-columns: auto minmax(0, 1fr); }
    .attachment-actions { grid-column: 1 / -1; }
  }
</style>
