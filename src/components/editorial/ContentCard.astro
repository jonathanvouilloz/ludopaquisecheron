---
interface Props {
  title: string
  summary: string
  href: string
  meta: string[]
  image?: { url: string; alt: string } | null
  linkLabel?: string
}
const { title, summary, href, meta, image = null, linkLabel = 'Lire la suite' } = Astro.props
---
<article class="content-card content-card--link">
  <a class="content-card__target" href={href} aria-label={`${linkLabel} : ${title}`}>
    {image && <img class="content-card__image" src={image.url} alt={image.alt} loading="lazy" />}
    <div class="content-card__body">
      <div class="content-card__meta">{meta.map((item) => <span>{item}</span>)}</div>
      <h2>{title}</h2>
      <p>{summary}</p>
      <span class="content-card__link">{linkLabel}<i class="ph ph-arrow-right" aria-hidden="true"></i></span>
    </div>
  </a>
</article>

<style>
  .content-card--link { min-height: 0; padding: 0; transition: border-color var(--transition-tactile), box-shadow var(--transition-tactile); }
  .content-card--link:hover { border-color: var(--color-brand); box-shadow: var(--shadow-card-hover); }
  .content-card--link:focus-within { border-color: var(--color-brand); box-shadow: var(--shadow-card-hover); }
  .content-card__target { display: flex; height: 100%; flex-direction: column; color: inherit; text-decoration: none; }
  .content-card__image { display: block; width: calc(100% - (var(--space-5) * 2)); aspect-ratio: 16 / 9; margin: var(--space-5) var(--space-5) 0; border-radius: var(--radius-sm); object-fit: cover; }
  .content-card__body { display: flex; flex: 1; flex-direction: column; padding: var(--space-5); }
  .content-card--link .content-card__meta { gap: var(--space-2); margin-bottom: 0; color: var(--color-ink-muted); font-size: .82rem; font-weight: 700; }
  .content-card--link .content-card__meta span { display: inline-flex; align-items: center; padding: 0; border-radius: 0; background: transparent; }
  .content-card--link .content-card__meta span + span::before { margin-right: var(--space-2); color: var(--color-brand-muted); content: '·'; }
  .content-card--link .content-card__link { margin-top: auto; padding-top: var(--space-5); }
  .content-card__target:focus-visible { outline: 3px solid var(--color-highlight); outline-offset: 3px; }
  @media (hover: none) { .content-card--link:hover { border-color: var(--color-border); box-shadow: var(--shadow-card); } }
</style>
