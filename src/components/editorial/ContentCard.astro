---
interface Props {
  title: string
  summary: string
  href: string
  meta: string[]
  image?: { url: string; alt: string } | null
  imagePlaceholder?: boolean
  imageFit?: 'cover' | 'contain'
  linkLabel?: string
  layout?: 'card' | 'row'
}
const { title, summary, href, meta, image = null, imagePlaceholder = false, imageFit = 'cover', linkLabel = 'Lire la suite', layout = 'card' } = Astro.props
---
<article class:list={[
  'content-card',
  'content-card--link',
  `content-card--${layout}`,
  { 'content-card--row-no-image': layout === 'row' && !image && !imagePlaceholder, 'content-card--image-contain': imageFit === 'contain' },
]}>
  <a class="content-card__target" href={href} aria-label={`${linkLabel} : ${title}`}>
    {image ? <img class="content-card__image" src={image.url} alt={image.alt} loading="lazy" /> : imagePlaceholder && <div class="content-card__placeholder" aria-hidden="true"><i class="ph ph-newspaper"></i></div>}
    <div class="content-card__body">
      <div class="content-card__meta">{meta.map((item) => <span>{item}</span>)}</div>
      <h2>{title}</h2>
      <p>{summary}</p>
      <span class="content-card__link">{linkLabel}<i class="ph ph-arrow-right" aria-hidden="true"></i></span>
    </div>
  </a>
</article>

<style>
  .content-card--link { display: flex; flex-direction: column; min-height: 16.25rem; padding: 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-card); transition: border-color var(--transition-tactile), box-shadow var(--transition-tactile); }
  .content-card--link:hover { border-color: var(--color-brand); box-shadow: var(--shadow-card-hover); }
  .content-card--link:focus-within { border-color: var(--color-brand); box-shadow: var(--shadow-card-hover); }
  .content-card__target { display: flex; height: 100%; flex-direction: column; color: inherit; text-decoration: none; }
  .content-card__image { display: block; width: calc(100% - (var(--space-5) * 2)); aspect-ratio: 16 / 9; margin: var(--space-5) var(--space-5) 0; border-radius: var(--radius-md); object-fit: cover; }
  .content-card--image-contain .content-card__image { padding: var(--space-2); background: var(--color-page); object-fit: contain; }
  .content-card__placeholder { display: grid; width: calc(100% - (var(--space-5) * 2)); aspect-ratio: 16 / 9; place-items: center; margin: var(--space-5) var(--space-5) 0; border-radius: var(--radius-md); background: var(--color-brand-soft); color: var(--color-brand-dark); font-size: 2rem; }
  .content-card__body { display: flex; flex: 1; flex-direction: column; padding: var(--space-5); }
  .content-card--link .content-card__meta { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: 0; color: var(--color-brand-dark); font-size: .72rem; font-weight: 600; line-height: 1.2; }
  .content-card--link .content-card__meta span { display: inline-flex; align-items: center; padding: .15rem .45rem; border-radius: var(--radius-pill); background: var(--color-brand-soft); }
  .content-card--link .content-card__meta span + span::before { content: none; }
  .content-card--link h2 { margin-block: var(--space-4) var(--space-2); color: var(--color-brand-dark); font-family: var(--font-display); font-size: clamp(1.65rem, 2.5vw, 1.8rem); font-weight: 400; letter-spacing: var(--tracking-heading); line-height: 1.15; }
  .content-card--link p { color: var(--color-ink-muted); }
  .content-card--link .content-card__link { display: inline-flex; align-items: center; gap: var(--space-2); margin-top: auto; padding-top: var(--space-5); color: var(--color-brand-dark); font-family: var(--font-ui); font-weight: 700; }
  .content-card__target:focus-visible { outline: 3px solid var(--color-brand-dark); outline-offset: 3px; }
  .content-card--row { min-height: 0; }
  .content-card--row .content-card__target { display: grid; grid-template-columns: minmax(10rem, 12rem) minmax(0, 1fr); }
  .content-card--row .content-card__image { width: 100%; min-height: 10.5rem; height: 100%; margin: 0; border-radius: var(--radius-md) 0 0 var(--radius-md); aspect-ratio: auto; }
  .content-card--row .content-card__placeholder { display: grid; width: 100%; min-height: 10.5rem; height: 100%; margin: 0; border-radius: var(--radius-md) 0 0 var(--radius-md); aspect-ratio: auto; }
  .content-card--row .content-card__body { padding: var(--space-5) var(--space-6); }
  .content-card--row h2 { margin-block: var(--space-3) var(--space-2); font-size: clamp(1.45rem, 2vw, 1.6rem); letter-spacing: var(--tracking-heading); }
  .content-card--row p { margin-bottom: 0; }
  .content-card--row .content-card__link { padding-top: var(--space-3); }
  .content-card--row-no-image .content-card__target { grid-template-columns: 1fr; }
  @media (max-width: 560px) {
    .content-card--row .content-card__target { grid-template-columns: 1fr; }
    .content-card--row .content-card__image { min-height: 0; height: auto; aspect-ratio: 16 / 9; border-radius: var(--radius-md); margin: var(--space-4) var(--space-4) 0; width: calc(100% - (var(--space-4) * 2)); }
    .content-card--row .content-card__placeholder { min-height: 0; height: auto; aspect-ratio: 16 / 9; border-radius: var(--radius-md); margin: var(--space-4) var(--space-4) 0; width: calc(100% - (var(--space-4) * 2)); }
  }
  @media (hover: none) { .content-card--link:hover { border-color: var(--color-border); box-shadow: var(--shadow-card); } }
</style>
