---
import type { ActivityRegistration } from '../../lib/ludohub/types.js'
import { ACTIVITY_WAITLIST_MESSAGE } from '../../lib/ludohub/validators.js'

type Props = {
  activityTitle: string
  endpoint: string | null
  registration: ActivityRegistration
}

const { activityTitle, endpoint, registration } = Astro.props
const isAvailable = Boolean(endpoint)
---

<section class="contact-form-panel registration-panel" aria-labelledby="registration-title">
  <div class="form-status" data-registration-status role="status" aria-live="polite">
    <i class={`ph ${registration.isAtCapacity ? 'ph-hourglass' : 'ph-info'}`} aria-hidden="true"></i>
    <span>
      {!isAvailable
        ? 'L’inscription en ligne est temporairement indisponible. Contactez l’équipe.'
        : registration.isAtCapacity
          ? ACTIVITY_WAITLIST_MESSAGE
          : 'Le formulaire est prêt.'}
    </span>
  </div>
  <h2 id="registration-title">S’inscrire à cette activité</h2>
  <p>{registration.isAtCapacity ? 'Vous pouvez laisser une demande pour la liste d’attente.' : `Demandez une inscription pour « ${activityTitle} ».`}</p>
  <form data-registration-form data-registration-endpoint={endpoint ?? undefined}>
    <div class="field"><label for="registration-name">Nom de contact</label><input id="registration-name" name="contactName" autocomplete="name" required /></div>
    <div class="field"><label for="registration-email">E-mail</label><input id="registration-email" name="email" type="email" autocomplete="email" required /></div>
    <div class="field"><label for="registration-phone">Téléphone <span>(facultatif)</span></label><input id="registration-phone" name="phone" type="tel" autocomplete="tel" /></div>
    <div class="field"><label for="registration-count">Nombre de participants</label><input id="registration-count" name="participantCount" type="number" min="1" max="50" step="1" value="1" required /></div>
    <div class="field field--wide"><label for="registration-message">Message <span>(facultatif)</span></label><textarea id="registration-message" name="message" rows="4"></textarea></div>
    <div class="registration-honeypot" aria-hidden="true"><label for="registration-website">Site internet</label><input id="registration-website" name="website" tabindex="-1" autocomplete="off" /></div>
    <button class="button button--brand" type="submit" disabled={!isAvailable}><span>{isAvailable ? (registration.isAtCapacity ? 'Rejoindre la liste d’attente' : 'Demander mon inscription') : 'Inscription indisponible'}</span><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i></button>
  </form>
  <p class="form-fallback">L’envoi confirme uniquement la réception de votre demande. L’équipe vous contactera si nécessaire.</p>
</section>

<script>
  import { ACTIVITY_RECEIVED_MESSAGE, ACTIVITY_WAITLIST_MESSAGE, activityRegistrationReceipt } from '../../lib/ludohub/validators.js'

  const form = document.querySelector<HTMLFormElement>('[data-registration-form]')
  const status = document.querySelector<HTMLElement>('[data-registration-status]')
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]')
  let idempotencyKey: string | null = null

  const setStatus = (message: string) => {
    const text = status?.querySelector('span')
    if (text) text.textContent = message
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const endpoint = form.dataset.registrationEndpoint
    if (!endpoint || !submitButton) {
      setStatus('L’inscription en ligne est indisponible. Contactez l’équipe.')
      return
    }
    if (!form.reportValidity()) return
    if (!globalThis.crypto?.randomUUID) {
      setStatus('Votre navigateur ne permet pas un envoi sécurisé. Contactez l’équipe.')
      return
    }

    const values = new FormData(form)
    const phone = String(values.get('phone') ?? '').trim()
    const message = String(values.get('message') ?? '').trim()
    const payload = {
      contactName: String(values.get('contactName') ?? '').trim(),
      email: String(values.get('email') ?? '').trim(),
      ...(phone ? { phone } : {}),
      participantCount: Number(values.get('participantCount')),
      ...(message ? { message } : {}),
      website: String(values.get('website') ?? ''),
    }
    idempotencyKey ??= crypto.randomUUID()
    submitButton.disabled = true
    form.setAttribute('aria-busy', 'true')
    setStatus('Envoi en cours…')

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'Idempotency-Key': idempotencyKey },
        body: JSON.stringify(payload),
      })
      let rawReceipt: unknown = null
      if (response.status === 200 || response.status === 201) {
        try { rawReceipt = await response.json() } catch { rawReceipt = null }
      }
      const receipt = activityRegistrationReceipt(rawReceipt)
      if ((response.status === 200 || response.status === 201) && receipt) {
        form.reset()
        idempotencyKey = null
        setStatus(receipt.status === 'waitlisted'
          ? ACTIVITY_WAITLIST_MESSAGE
          : ACTIVITY_RECEIVED_MESSAGE)
      } else if (response.status === 400) {
        setStatus('Certains champs sont invalides. Vérifiez votre demande puis réessayez.')
      } else if (response.status === 429) {
        setStatus('Trop de tentatives ont été envoyées. Patientez avant de réessayer ou contactez l’équipe.')
      } else {
        setStatus('Le service d’inscription est indisponible. Contactez l’équipe.')
      }
    } catch {
      setStatus('Le service d’inscription est indisponible. Vérifiez votre connexion ou contactez l’équipe.')
    } finally {
      form.removeAttribute('aria-busy')
      submitButton.disabled = false
    }
  })
</script>

<style>
  .registration-panel { margin-top: clamp(2rem, 5vw, 4rem); }
  .registration-honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
