---
interface Props {
  tone?: 'brand' | 'surface' | 'soft' | 'dark' | 'cutout'
  flip?: boolean
  rider?: boolean
}

const { tone = 'brand', flip = false, rider = false } = Astro.props
---

<div class:list={['wave-divider', `wave-divider--${tone}`, { 'wave-divider--flip': flip, 'wave-divider--with-rider': rider }]} aria-hidden="true">
  <svg viewBox="0 0 1440 120" preserveAspectRatio="none" focusable="false">
    {tone === 'cutout'
      ? <path d="M0 0H1440V61C1305 105 1174 100 1015 52C860 5 728-7 528 53C350 106 174 103 0 38Z"></path>
      : <path d="M0 38C174 103 350 106 528 53C728-7 860 5 1015 52C1174 100 1305 105 1440 61V120H0Z"></path>}
  </svg>
  {rider && (
    <span class="wave-rider">
      <svg viewBox="0 0 100 82" focusable="false">
        <path class="wave-rider__scarf" d="M49 19c-9-7-15-6-22-2 7 2 11 7 14 12Z"></path>
        <circle class="wave-rider__head" cx="55" cy="15" r="9"></circle>
        <path class="wave-rider__body" d="m51 25-10 21m11-20 12 17m-23 3 17 12m-6-29 16 4"></path>
        <g class="wave-rider__bike">
          <circle cx="22" cy="61" r="15"></circle>
          <circle cx="76" cy="61" r="15"></circle>
          <path d="m22 61 18-24 18 24H22Zm18-24 10 24m8 0 11-29m-17 0h16m-32 0h11"></path>
        </g>
      </svg>
    </span>
  )}
</div>
