---
import '../styles/global.css'
import '@phosphor-icons/web/regular'
import { absoluteSiteUrl, readSiteOrigin, serializeJsonLd } from '../lib/site-origin'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  forcedTheme?: 'paquis' | 'secheron'
  structuredData?: Record<string, unknown> | null
}

const {
  title,
  description = 'Deux ludothèques de quartier pour jouer, découvrir et partager à Genève.',
  noindex = false,
  forcedTheme,
  structuredData = null,
} = Astro.props
const origin = readSiteOrigin()
const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '')
const canonical = absoluteSiteUrl(canonicalPath, origin)
const effectiveNoindex = noindex || !origin
const socialTitle = title
const organization = canonical && !effectiveNoindex ? {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ludothèque Pâquis-Sécheron',
  url: origin!.toString(),
} : null
const jsonLd = organization ? [organization, ...(structuredData ? [structuredData] : [])] : []
---

<!doctype html>
<html lang="fr" data-ludo-theme={forcedTheme ?? 'paquis'} data-theme-locked={forcedTheme ?? undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={effectiveNoindex ? 'noindex,follow' : 'index,follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((entry) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(entry)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bubblegum+Sans&family=Fredoka:wght@500;600;700&family=Open+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      const forcedTheme = document.documentElement.dataset.themeLocked;
      (() => {
        if (forcedTheme === 'paquis' || forcedTheme === 'secheron') {
          document.documentElement.dataset.ludoTheme = forcedTheme
          return
        }
        try {
          const storedTheme = localStorage.getItem('ludo-theme')
          document.documentElement.dataset.ludoTheme = storedTheme === 'secheron' ? 'secheron' : 'paquis'
        } catch {
          document.documentElement.dataset.ludoTheme = 'paquis'
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
