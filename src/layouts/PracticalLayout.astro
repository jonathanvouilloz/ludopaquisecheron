---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import WaveDivider from '../components/WaveDivider.astro'

interface Props {
  title: string
  description?: string
  activePath: string
  noindex?: boolean
  structuredData?: Record<string, unknown> | null
}

const { title, description, activePath, noindex = false, structuredData = null } = Astro.props
---

<BaseLayout title={title} description={description} noindex={noindex} structuredData={structuredData}>
  <Header activePath={activePath} />
  <main id="contenu"><slot /></main>
  <WaveDivider tone="dark" flip />
  <Footer />
</BaseLayout>
