---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import WaveDivider from '../components/WaveDivider.astro'

interface Props {
  title: string
  description?: string
  activePath: string
  forcedTheme?: 'paquis' | 'secheron'
}

const { title, description, activePath, forcedTheme } = Astro.props
---

<BaseLayout title={title} description={description} forcedTheme={forcedTheme}>
  <Header activePath={activePath} />
  <main id="contenu"><slot /></main>
  <WaveDivider tone="dark" flip />
  <Footer />
</BaseLayout>
