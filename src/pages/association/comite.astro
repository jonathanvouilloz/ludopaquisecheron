---
import EditorialLayout from '../../components/editorial/EditorialLayout.astro'
import { loadProfiles } from '../../data/editorial'
const content = await loadProfiles('committee')
---
<EditorialLayout title="Le comité" description="Le comité de l’association de la ludothèque." question="Qui porte l’association ?" intro="Découvrez les personnes engagées dans la gouvernance de l’association." sourceNotice={content.notice} noindex={content.noindex}>
  <span slot="kicker">Association · comité</span>
  <section class="editorial-section" aria-labelledby="comite"><div class="editorial-section__heading"><h2 id="comite">Composition du comité</h2><p>Les noms et rôles publiés ont été validés par l’association.</p></div>{content.items.length ? <div class="content-grid">{content.items.map((person) => <article class="content-card"><div class="content-card__meta"><span>{person.role}</span></div><h2>{person.name}</h2>{person.bio && <p>{person.bio}</p>}</article>)}</div> : <div class="status-panel"><h3>Aucun profil publié</h3><p>Pour joindre l’association, utilisez la page <a href="/contact">Contact</a>.</p></div>}</section>
</EditorialLayout>
