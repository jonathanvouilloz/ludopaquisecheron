---
import EditorialLayout from '../../components/editorial/EditorialLayout.astro'
import { loadDocuments } from '../../data/editorial'

const content = await loadDocuments()
const documents = content.items.filter((item) => item.kind !== 'mission')
const kindLabel = { statutes: 'Statuts', annual_report: 'Rapport annuel', other: 'Document' }
---
<EditorialLayout title="Documents" description="Les documents publics de l’association." question="Quels documents peut-on consulter ?" intro="Retrouvez les statuts, rapports annuels et autres versions publiques approuvées." sourceNotice={content.notice} noindex={content.noindex}>
  <span slot="kicker">Association · documents</span>
  <section class="editorial-section" aria-labelledby="documents"><div class="editorial-section__heading"><h2 id="documents">Documents publiés</h2><p>Chaque fichier ouvre la version publique fournie par l’association.</p></div>{documents.length ? <div class="content-grid">{documents.map((document) => <article class="content-card"><div class="content-card__meta"><span>{kindLabel[document.kind as keyof typeof kindLabel]}</span>{document.year && <span>{document.year}</span>}</div><h2>{document.title}</h2><p>{document.summary}</p>{document.body.map((paragraph) => <p>{paragraph}</p>)}{document.pdf ? <a class="content-card__link" href={document.pdf.url} target="_blank" rel="noopener noreferrer"><i class="ph ph-file-pdf" aria-hidden="true"></i>Ouvrir {document.pdf.fileName}</a> : <span class="content-card__link" aria-disabled="true"><i class="ph ph-file" aria-hidden="true"></i>{document.detailAvailable ? 'Consulter le texte ci-dessus' : 'Détail temporairement indisponible'}</span>}</article>)}</div> : <div class="status-panel"><h3>Aucun document publié</h3><p>Les versions approuvées apparaîtront ici. <a href="/contact">Contactez l’association</a> pour une demande.</p></div>}</section>
</EditorialLayout>
