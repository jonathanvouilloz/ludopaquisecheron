---
import LocationPage from '../components/LocationPage.astro'
import { loadPracticalPlaces } from '../data/practical'

const result = await loadPracticalPlaces()
const place = result.data.find((item) => item.key === 'secheron') ?? null
---

<LocationPage place={place} placeKey="secheron" source={result.source} reason={result.reason} />
