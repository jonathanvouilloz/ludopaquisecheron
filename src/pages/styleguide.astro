---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import WaveDivider from '../components/WaveDivider.astro'
import ButtonLink from '../components/ButtonLink.astro'
import AgeCard from '../components/AgeCard.astro'
import GameCard from '../components/GameCard.astro'
import LocationCard from '../components/LocationCard.astro'
import ContentCard from '../components/editorial/ContentCard.astro'
import { ageGroups, featuredGames, locations } from '../data/site'

const swatches = [
  { name: 'Bleu Pâquis', value: '#5E7DD9', token: '--color-brand · --color-paquis' },
  { name: 'Bleu pastel', value: '#D7DFF6', token: '--color-brand-soft · --color-paquis-soft' },
  { name: 'Vert Sécheron', value: '#38941A', token: '--color-secheron' },
  { name: 'Vert pastel', value: '#E4F7DD', token: '--color-secheron-soft' },
  { name: 'Rose accent', value: '#D95E7D', token: '--color-accent' },
  { name: 'Rose pastel', value: '#F7C5DD', token: '--color-accent-soft' },
  { name: 'Encre', value: '#333333', token: '--color-ink' },
  { name: 'Fond de page', value: '#F5F7F7', token: '--color-page' },
  { name: 'Carte', value: '#FFFFFF', token: '--color-surface' },
]
---

<BaseLayout title="Styleguide — Ludothèque Pâquis-Sécheron" description="Référence interne des couleurs, composants et principes visuels du site." noindex>
  <Header activePath="/styleguide" />
  <main id="contenu">
    <section class="styleguide-hero">
      <div class="shell">
        <h1>Un terrain de jeu plus doux</h1>
        <p>Le pattern historique reste visible derrière une interface pastel, plus légère et plus lisible. Les cartes blanches portent l’information et les couleurs distinguent les deux lieux.</p>
        <ButtonLink href="/" variant="light">Voir la page d’accueil</ButtonLink>
      </div>
    </section>

    <WaveDivider tone="cutout" />

    <section class="styleguide-section">
      <div class="shell">
        <h2>Palette</h2>
        <div class="swatch-grid">
          {swatches.map((swatch) => (
            <article class="swatch">
              <div class="swatch__color" style={`--swatch: ${swatch.value}`}></div>
              <div class="swatch__meta"><strong>{swatch.name}</strong><code>{swatch.value} · {swatch.token}</code></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="styleguide-section">
      <div class="shell">
        <h2>Typographie</h2>
        <div class="type-specimen">
          <div><p class="eyebrow">Questrial · Titres</p><p class="display">Mille façons de jouer.</p></div>
          <div><p class="eyebrow">Inter · Interface</p><p class="ui">Jeux par âge · Voir les horaires · Aux Pâquis</p></div>
          <div><p class="eyebrow">Inter · Lecture</p><p>La ludothèque accueille les enfants, les familles, les adultes, les seniors et les institutions. Le texte reste simple, généreux et facile à parcourir.</p></div>
        </div>
      </div>
    </section>

    <section class="styleguide-section">
      <div class="shell">
        <h2>Boutons</h2>
        <div class="component-row">
          <ButtonLink href="#">Action principale</ButtonLink>
          <ButtonLink href="#" variant="brand">Action principale</ButtonLink>
          <ButtonLink href="#" variant="outline">Action secondaire</ButtonLink>
        </div>
      </div>
    </section>

    <section class="styleguide-section section--brand">
      <div class="shell">
        <h2 style="color: var(--color-brand-dark)">Choisir par âge</h2>
        <div class="age-grid">{ageGroups.map((group) => <AgeCard group={group} />)}</div>
      </div>
    </section>

    <WaveDivider tone="cutout" />

    <section class="styleguide-section">
      <div class="shell">
        <h2>Cartes de contenu</h2>
        <div class="component-stack">
          <div class="editorial-grid">
            <ContentCard
              title="Après-midi jeux en famille"
              summary="Un rendez-vous convivial pour découvrir de nouveaux jeux ensemble."
              href="#"
              meta={['Activité', 'Mercredi · 14h30', 'Pâquis']}
              imagePlaceholder
              linkLabel="Voir l’activité"
            />
          </div>
          <div class="game-list">
            {featuredGames.slice(0, 2).map((game, index) => <GameCard game={game} rank={index + 1} />)}
          </div>
          <div class="location-grid">
            {locations.map((location) => <LocationCard location={location} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="styleguide-section section--soft">
      <div class="shell">
        <h2>Pattern et rythme</h2>
        <p class="reading-width">Le pattern existant reste le décor commun des pages. Les vagues deviennent discrètes et servent uniquement les transitions majeures.</p>
      </div>
    </section>
  </main>

  <WaveDivider tone="dark" flip />
  <Footer />
</BaseLayout>
