---
import EditorialLayout from '../../components/editorial/EditorialLayout.astro'
import ContentCard from '../../components/editorial/ContentCard.astro'
import { loadActivities } from '../../data/editorial'

const content = await loadActivities(true)
---
<EditorialLayout title="Archives des activités" description="Les activités terminées de la Ludothèque Pâquis-Sécheron." question="Que s’est-il passé à la ludothèque ?" intro="Les activités terminées vivent dans un espace distinct et restent partageables." sourceNotice={content.notice} noindex={content.noindex}>
  <span slot="kicker">Activités · archives</span>
  <section class="editorial-section" aria-labelledby="archives"><div class="editorial-section__heading"><h2 id="archives">Activités terminées</h2><p>Leur statut passé est toujours explicite.</p></div>{content.items.length ? <div class="content-grid">{content.items.map((item) => <ContentCard title={item.title} summary={item.summary} href={`/activites/${item.slug}`} meta={['Activité terminée', item.dateLabel]} linkLabel="Voir l’activité" />)}</div> : <div class="status-panel"><h3>Aucune archive</h3><p>Les activités passées apparaîtront ici après leur clôture.</p></div>}</section>
</EditorialLayout>
