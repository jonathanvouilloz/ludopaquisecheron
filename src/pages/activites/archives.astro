---
import EditorialLayout from '../../components/editorial/EditorialLayout.astro'
import ContentCard from '../../components/editorial/ContentCard.astro'
import { archivedActivities } from '../../data/editorial'
---
<EditorialLayout title="Archives des activités" description="Les activités terminées de la Ludothèque Pâquis-Sécheron." question="Que s’est-il passé à la ludothèque ?" intro="Les activités terminées vivent dans un espace distinct. La liste actuelle est purement démonstrative.">
  <span slot="kicker">Activités · archives</span>
  <section class="editorial-section" aria-labelledby="archives"><div class="editorial-section__heading"><h2 id="archives">Activités terminées</h2><p>Une archive reste consultable et partageable, mais son statut passé est toujours explicite.</p></div>{archivedActivities.length ? <div class="content-grid">{archivedActivities.map((item) => <ContentCard title={item.title} summary={item.summary} href={`/activites/${item.slug}`} meta={[item.dateLabel, 'Terminée', 'Exemple']} />)}</div> : <div class="status-panel"><h3>Aucune archive</h3><p>Les activités passées apparaîtront ici après leur clôture.</p></div>}</section>
</EditorialLayout>
