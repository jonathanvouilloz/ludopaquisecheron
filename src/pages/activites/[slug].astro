---
import EditorialLayout from '../../components/editorial/EditorialLayout.astro'
import ActivityRegistrationForm from '../../components/editorial/ActivityRegistrationForm.astro'
import { canRegisterForActivity, loadActivityRoutes, type ActivityView, type EditorialSource } from '../../data/editorial'
import { publicActivityRegistrationEndpoint } from '../../lib/ludohub/config.js'
export async function getStaticPaths() {
  const content = await loadActivityRoutes()
  const source: EditorialSource = { mode: content.mode, notice: content.notice, noindex: content.noindex, reason: content.reason }
  return content.items.map((item) => ({ params: { slug: item.slug }, props: { item, source } }))
}
const { item, source } = Astro.props as { item: ActivityView; source: EditorialSource }
const registrationAvailable = canRegisterForActivity(item, source.mode)
const registrationEndpoint = registrationAvailable
  ? publicActivityRegistrationEndpoint(item.slug)
  : null
---
<EditorialLayout title={item.title} description={item.summary} question={item.question} intro={item.summary} activePath="/activites" sourceNotice={source.notice} noindex={source.noindex}>
  <span slot="kicker">Activité · {item.archived ? 'archive' : source.mode === 'live' ? 'publication' : 'exemple'}</span>
  <article class="editorial-section detail-layout">
    <div class="prose">{item.body.map((paragraph) => <p>{paragraph}</p>)}{!item.detailAvailable && <div class="status-panel"><h2>Détail temporairement indisponible</h2><p>Consultez le résumé ou <a href="/contact">contactez l’équipe</a> avant de vous déplacer.</p></div>}{source.mode === 'demo' && <div class="status-panel"><h2>Ne pas se déplacer sur cette base</h2><p>La date et les modalités de cet exemple ne sont pas confirmées.</p></div>}<a class="share-link" href={Astro.url.pathname}><i class="ph ph-link" aria-hidden="true"></i>Lien permanent vers cette activité</a></div>
    <aside class="detail-aside" aria-label="Informations sur l’activité"><dl><div><dt>Quand</dt><dd>{item.schedule}</dd></div><div><dt>Où</dt><dd>{item.location}</dd></div><div><dt>Pour qui</dt><dd>{item.audience}</dd></div></dl></aside>
  </article>
  {registrationAvailable && item.registration && <ActivityRegistrationForm activityTitle={item.title} endpoint={registrationEndpoint} registration={item.registration} />}
</EditorialLayout>
