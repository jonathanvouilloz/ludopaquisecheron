---
import EditorialLayout from '../../components/editorial/EditorialLayout.astro'
import ActivityRegistrationForm from '../../components/editorial/ActivityRegistrationForm.astro'
import { canRegisterForActivity, loadActivityDetail } from '../../data/editorial'
import { publicActivityRegistrationEndpoint } from '../../lib/ludohub/config.js'

const slug = Astro.params.slug
const content = slug ? await loadActivityDetail(slug) : null
if (!content) return Astro.redirect('/404')
const { item, ...source } = content
const registrationAvailable = canRegisterForActivity(item, source.mode)
const registrationEndpoint = registrationAvailable
  ? publicActivityRegistrationEndpoint(item.slug)
  : null
---
<EditorialLayout title={item.title} description={item.summary} question={item.question} intro={item.summary} activePath="/activites" sourceNotice={source.notice} noindex={source.noindex}>
  <span slot="kicker">Activité · {item.archived ? 'archive' : 'publication'}</span>
  <article class="editorial-section detail-layout">
    <div class="prose">
      {item.image && <img class="editorial-image" src={item.image.url} alt={item.image.alt} loading="eager" />}
      {item.body.map((paragraph) => <p>{paragraph}</p>)}
      <a class="share-link" href={Astro.url.pathname}><i class="ph ph-link" aria-hidden="true"></i>Lien permanent vers cette activité</a>
    </div>
    <aside class="detail-aside" aria-label="Informations sur l’activité"><dl><div><dt>Quand</dt><dd>{item.schedule}</dd></div><div><dt>Où</dt><dd>{item.location}</dd></div><div><dt>Pour qui</dt><dd>{item.audience}</dd></div></dl></aside>
  </article>
  {registrationAvailable && item.registration && <ActivityRegistrationForm activityTitle={item.title} endpoint={registrationEndpoint} registration={item.registration} />}
</EditorialLayout>

<style>
  .editorial-image { width: 100%; max-height: 32rem; margin-bottom: var(--space-5); border-radius: var(--radius-lg); object-fit: cover; }
</style>
