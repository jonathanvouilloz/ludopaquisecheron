---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import WaveDivider from '../components/WaveDivider.astro'
import ButtonLink from '../components/ButtonLink.astro'
import SectionHeading from '../components/SectionHeading.astro'
import AgeCard from '../components/AgeCard.astro'
import GameCard from '../components/GameCard.astro'
import LocationCard from '../components/LocationCard.astro'
import { ageGroups } from '../data/site'
import { loadHomepageData } from '../data/home'

const home = await loadHomepageData()
const homeGames = (home.selectedTopThree?.games ?? []).map((game, index) => ({
  name: game.name,
  ageGroup: 'grands',
  age: `Choix n°${index + 1}`,
  description: game.reason,
  accent: (['yellow', 'periwinkle', 'rose'] as const)[index] ?? 'blue',
}))
const homeLocations = home.places.data.map((place) => ({
  ...place,
  summary: place.introduction,
  color: place.key === 'paquis' ? ('rose' as const) : ('yellow' as const),
}))
---

<BaseLayout
  title="Ludothèque Pâquis-Sécheron — Deux lieux, mille façons de jouer"
  noindex={home.noindex}
>
  {home.demoNotice && <p class="work-notice">{home.demoNotice}</p>}
  {home.announcements.items.map((announcement) => (
    <p class="work-notice"><strong>{announcement.title}</strong> · {announcement.message}</p>
  ))}
  <Header />

  <main id="contenu">
    <section class="hero">
      <div class="shell hero__grid">
        <div>
          <h1>Deux lieux,<br /><span class="highlight">mille façons</span><br />de jouer.</h1>
          <p class="hero__lead">Aux Pâquis et à Sécheron, venez jouer sur place, découvrir de nouveaux jeux et partager un moment avec d’autres familles.</p>
          <div class="hero__actions">
            <ButtonLink href="/infos-pratiques" variant="brand" icon="clock">Voir les horaires</ButtonLink>
            <ButtonLink href="/top-3" variant="outline">Choisir un jeu</ButtonLink>
          </div>
        </div>

        <div class="hero-art" aria-label="Entrée de la ludothèque des Pâquis">
          <div class="hero-art__photo">
            <img src="/images/exterieur-paquis.png" alt="Entrée de la ludothèque des Pâquis" width="354" height="354" />
          </div>
          <span class="hero-art__shape hero-art__shape--rose" aria-hidden="true"><i class="ph ph-star-four"></i></span>
          <span class="hero-art__shape hero-art__shape--yellow" aria-hidden="true">●</span>
          <span class="hero-art__dots" aria-hidden="true">{Array.from({ length: 12 }, () => <i></i>)}</span>
        </div>
      </div>
    </section>

    <WaveDivider tone="brand" rider />

    <section class="section section--brand" id="jeux-par-age">
      <div class="shell">
        <SectionHeading
          title="On commence par quel âge ?"
          description="Quatre portes d’entrée simples pour trouver un jeu adapté, sans transformer le site en catalogue géant."
          inverse
        />
        <div class="age-grid">
          {ageGroups.map((group) => <AgeCard group={group} />)}
        </div>
      </div>
    </section>

    <WaveDivider tone="cutout" flip />

    <section class="section section--surface">
      <div class="shell games-showcase">
        <div class="games-showcase__intro">
          <h2>{home.selectedTopThree?.theme ?? 'Le Top 3 de l’équipe'}</h2>
          <p>{home.selectedTopThree ? 'Une sélection choisie et publiée par l’équipe.' : 'Aucune sélection n’est publiée sur l’accueil pour le moment.'}</p>
          <ButtonLink href="/top-3" variant="brand">Toutes les sélections</ButtonLink>
        </div>
        {homeGames.length > 0 ? (
          <div class="game-list">
            {homeGames.map((game, index) => <GameCard game={game} rank={index + 1} />)}
          </div>
        ) : <p class="empty-state">Le prochain Top 3 est en préparation.</p>}
      </div>
    </section>

    <div class="toy-separator" aria-hidden="true"><i class="ph ph-circle"></i><i class="ph ph-square"></i><i class="ph ph-star-four"></i><i class="ph ph-triangle"></i></div>

    <section class="section section--surface section--locations" id="infos-pratiques">
      <div class="shell">
        <SectionHeading
          title="Choisissez votre ludothèque"
          description="Les deux lieux partagent la même équipe et le même esprit d’accueil, avec des adresses et horaires propres."
        />
        {homeLocations.length > 0 ? (
          <div class="location-grid">
            {homeLocations.map((location) => <LocationCard location={location} />)}
          </div>
        ) : <p class="empty-state">Les informations pratiques ne sont pas publiées pour le moment.</p>}
      </div>
    </section>

    <WaveDivider tone="brand" flip />

    <section class="section section--brand" id="association">
      <div class="shell manifesto-grid">
        <div class="manifesto-mark" aria-hidden="true">Joue !</div>
        <div class="manifesto-copy">
          <h2>Un lieu pour se rencontrer et grandir ensemble.</h2>
          <p>L’équipe conseille, explique les règles, accompagne les parties et prépare des espaces de jeu pour tous les âges. L’association crée un cadre ouvert où enfants, familles et institutions trouvent leur place.</p>
          <div class="promise-list" aria-label="Les engagements de la ludothèque">
            <span>Jouer librement sur place</span>
            <span>Être conseillé sans jugement</span>
            <span>Emprunter des jeux variés</span>
            <span>Partager entre générations</span>
          </div>
        </div>
      </div>
    </section>

    <WaveDivider tone="cutout" />

    <section class="section section--surface" id="actualites">
      <div class="shell">
        <SectionHeading
          title="Les dernières nouvelles"
          description="Fermetures, rendez-vous et nouvelles publiées par la ludothèque."
        />
        {home.news.items.length > 0 ? (
          <div class="editorial-grid">
            {home.news.items.map((item) => (
              <article class="editorial-card">
                <div class="editorial-card__shape" aria-hidden="true"><i class="ph ph-newspaper-clipping"></i></div>
                <h3><a href={item.detailAvailable ? `/actualites/${item.slug}` : '/actualites'}>{item.title}</a></h3>
                <p>{item.summary}</p>
              </article>
            ))}
          </div>
        ) : <p class="empty-state">Aucune actualité publiée pour le moment.</p>}
      </div>
    </section>

    <section class="section section--surface" id="activites">
      <div class="shell">
        <SectionHeading
          title="Activités à la une"
          description="Les rendez-vous que l’équipe a choisi de mettre en avant."
        />
        {home.featuredActivities.length > 0 ? (
          <div class="editorial-grid">
            {home.featuredActivities.map((item) => (
              <article class="editorial-card">
                <div class="editorial-card__shape" aria-hidden="true"><i class="ph ph-calendar-dots"></i></div>
                <h3><a href={item.detailAvailable ? `/activites/${item.slug}` : '/activites'}>{item.title}</a></h3>
                <p>{item.summary}</p>
              </article>
            ))}
          </div>
        ) : <p class="empty-state">Aucune activité n’est mise en avant pour le moment.</p>}
      </div>
    </section>
  </main>

  <WaveDivider tone="dark" flip />
  <Footer />
</BaseLayout>
