---
import PracticalLayout from '../layouts/PracticalLayout.astro'
import QuestionHero from '../components/QuestionHero.astro'
import { practicalPlaces } from '../data/practical'
---

<PracticalLayout title="Contact — Ludothèque Pâquis-Sécheron" activePath="/contact">
  <QuestionHero question="Comment joindre l’équipe ?" answer="Pour une réponse immédiate sur une ouverture, appelez directement la ludothèque. Pour une demande moins urgente, utilisez l’adresse e-mail commune." icon="envelope-simple" />
  <div class="shell practical-content contact-layout">
    <section class="contact-direct" aria-labelledby="contact-direct-title">
      <h2 id="contact-direct-title">Les contacts qui fonctionnent</h2>
      <a class="contact-action" href="mailto:lu.paquissecheron@fase.ch"><i class="ph ph-envelope-simple" aria-hidden="true"></i><span><strong>Écrire à l’équipe</strong><small>lu.paquissecheron@fase.ch</small></span></a>
      {Object.values(practicalPlaces).map((place) => (
        <a class="contact-action" href={`tel:${place.phone.replaceAll(' ', '')}`}><i class="ph ph-phone" aria-hidden="true"></i><span><strong>Appeler {place.shortName}</strong><small>{place.phone}</small></span></a>
      ))}
      <p>Les horaires et coordonnées proviennent de l’ancien site et restent à confirmer.</p>
    </section>

    <section class="contact-form-panel" aria-labelledby="contact-form-title">
      <div class="form-status"><i class="ph ph-info" aria-hidden="true"></i><span><strong>Aperçu uniquement</strong> Ce formulaire n’envoie pas encore de message.</span></div>
      <h2 id="contact-form-title">Préparer mon message</h2>
      <form aria-describedby="form-fallback">
        <div class="field"><label for="contact-name">Votre nom</label><input id="contact-name" name="name" autocomplete="name" /></div>
        <div class="field"><label for="contact-email">Votre e-mail</label><input id="contact-email" name="email" type="email" autocomplete="email" /></div>
        <div class="field"><label for="contact-phone">Votre téléphone <span>(facultatif)</span></label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" /></div>
        <div class="field"><label for="contact-recipient">Destinataire</label><select id="contact-recipient" name="recipient"><option value="general">Équipe générale</option><option value="paquis">Pâquis</option><option value="secheron">Sécheron</option></select></div>
        <div class="field field--wide"><label for="contact-subject">Sujet</label><input id="contact-subject" name="subject" /></div>
        <div class="field field--wide"><label for="contact-message">Votre question</label><textarea id="contact-message" name="message" rows="6"></textarea></div>
        <button class="button button--brand" type="button" disabled><span>Envoi bientôt disponible</span><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i></button>
      </form>
      <p id="form-fallback" class="form-fallback">Pour envoyer votre demande aujourd’hui, écrivez à <a href="mailto:lu.paquissecheron@fase.ch">lu.paquissecheron@fase.ch</a> ou appelez l’un des deux lieux.</p>
    </section>
  </div>
</PracticalLayout>
