---
import EditorialLayout from '../components/editorial/EditorialLayout.astro'
import { loadGallery } from '../data/editorial'

const content = await loadGallery()
---
<EditorialLayout title="Galerie" description="Découvrez les espaces et les activités de la ludothèque en images." question="À quoi ressemblent les lieux ?" intro="Quelques photos pour découvrir les lieux et les activités proposées au fil de l’année." sourceNotice={content.notice} noindex={content.noindex}>
  <span slot="kicker">Galerie</span>
  <section class="editorial-section" aria-labelledby="images"><div class="editorial-section__heading"><h2 id="images">La ludothèque en images</h2></div>
    {content.items.length ? <div class="gallery-grid">{content.items.map((item, index) => <figure class:list={["gallery-item", { "gallery-placeholder": item.demo }]}>{item.imageUrl ? <img src={item.imageUrl} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} /> : <div role="img" aria-label={item.alt}><i class="ph ph-image" aria-hidden="true"></i><span>Image {index + 1} à publier</span></div>}<figcaption>{item.caption}</figcaption></figure>)}</div> : <div class="status-panel"><h3>Aucune image publiée</h3><p>La galerie sera complétée prochainement. <a href="/paquis">Découvrez déjà les lieux</a>.</p></div>}
  </section>
</EditorialLayout>
<style>
  .gallery-grid { columns: 3; column-gap: var(--space-5); }
  .gallery-item { position: relative; break-inside: avoid; margin: 0 0 var(--space-5); border-radius: var(--radius-md); overflow: hidden; }
  .gallery-item img { display: block; width: 100%; height: auto; }
  .gallery-placeholder > div { display: grid; aspect-ratio: 4 / 3; place-items: center; align-content: center; gap: var(--space-3); background: var(--color-brand-soft); color: var(--color-brand-dark); }
  .gallery-placeholder i { font-size: 3rem; }
  .gallery-item figcaption { position: absolute; bottom: var(--space-3); left: var(--space-3); max-width: calc(100% - 1.5rem); padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); background: rgb(255 255 255 / 94%); color: var(--color-ink); font-family: var(--font-ui); font-size: 0.85rem; font-weight: 600; overflow-wrap: anywhere; }
  .gallery-item figcaption:empty { display: none; }
  @media (max-width: 960px) { .gallery-grid { columns: 2; } }
  @media (max-width: 640px) { .gallery-grid { columns: 1; } }
</style>
