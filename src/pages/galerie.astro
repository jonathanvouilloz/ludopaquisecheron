---
import EditorialLayout from '../components/editorial/EditorialLayout.astro'
import { galleryItems } from '../data/editorial'
---
<EditorialLayout title="Galerie" description="Découvrez les espaces et les activités de la ludothèque en images." question="À quoi ressemblent les lieux ?" intro="De futures photos locales et légendées aideront à préparer une première visite. Aucun emplacement ci-dessous n’est une photographie publiée.">
  <span slot="kicker">Galerie</span>
  <section class="editorial-section" aria-labelledby="images"><div class="editorial-section__heading"><h2 id="images">Images à venir</h2><p>Chaque photo sera choisie, décrite et vérifiée avant sa mise en ligne.</p></div>
    {galleryItems.length ? <div class="gallery-grid">{galleryItems.map((item, index) => <figure class="gallery-placeholder"><div role="img" aria-label={item.alt}><i class="ph ph-image" aria-hidden="true"></i><span>Image {index + 1} à publier</span></div><figcaption><strong>{item.title}</strong><span>{item.note}</span></figcaption></figure>)}</div> : <div class="status-panel"><h3>Aucune image publiée</h3><p>La galerie sera complétée après sélection des photos et vérification des autorisations.</p></div>}
  </section>
</EditorialLayout>
<style>
  .gallery-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: var(--space-5); }
  .gallery-placeholder { margin: 0; border: 2px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); overflow: hidden; }
  .gallery-placeholder:first-child { grid-row: span 2; }
  .gallery-placeholder > div { display: grid; place-items: center; align-content: center; gap: var(--space-3); min-height: 250px; background: var(--color-brand-soft); color: var(--color-brand-dark); }
  .gallery-placeholder:first-child > div { min-height: 470px; }
  .gallery-placeholder i { font-size: 3rem; }
  .gallery-placeholder figcaption { display: grid; padding: var(--space-4); }
  .gallery-placeholder strong { color: var(--color-brand-dark); font-family: var(--font-ui); }
  .gallery-placeholder span { color: var(--color-ink-muted); }
  @media (max-width: 760px) { .gallery-grid { grid-template-columns: 1fr; } .gallery-placeholder:first-child { grid-row: auto; } .gallery-placeholder:first-child > div { min-height: 300px; } }
</style>
