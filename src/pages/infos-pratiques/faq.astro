---
import PracticalLayout from '../../layouts/PracticalLayout.astro'
import QuestionHero from '../../components/QuestionHero.astro'
import ProvisionalNotice from '../../components/ProvisionalNotice.astro'
import PracticalNav from '../../components/PracticalNav.astro'
import { loadPracticalFaqs } from '../../data/practical'

const faqsResult = await loadPracticalFaqs()
---

<PracticalLayout title="Questions fréquentes — Ludothèque Pâquis-Sécheron" activePath="/infos-pratiques/faq" noindex={faqsResult.source === 'fallback'}>
  <QuestionHero question="Puis-je venir sans m’inscrire ?" answer="Oui pour découvrir les lieux et jouer sur place pendant les horaires d’ouverture. Une inscription est nécessaire pour emprunter." icon="question" />
  <div class="shell practical-content practical-content--reading">
    <ProvisionalNotice source={faqsResult.source} reason={faqsResult.reason} />
    <section class="faq-list" aria-label="Questions fréquentes">
      {faqsResult.data.map((faq, index) => <details open={index === 0}><summary>{faq.question}</summary><p>{faq.answerMarkdown}</p></details>)}
      {faqsResult.source === 'empty' && <div class="status-panel"><h2>Aucune réponse publiée</h2><p>La FAQ LudoHub est vide pour le moment. Utilisez la page contact pour poser votre question.</p></div>}
    </section>
    <PracticalNav />
  </div>
</PracticalLayout>
