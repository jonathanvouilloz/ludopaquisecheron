# Laisser vide pour désactiver tout appel réseau et utiliser les contenus de repli.
LUDOHUB_PUBLIC_API_BASE=

# Facultatif : paquis-secheron est également la valeur par défaut du client.
LUDOHUB_PUBLIC_LUDO_SLUG=paquis-secheron

# Origine canonique du déploiement, validée avant le lancement. Laisser vide en local.
# Exemple de test : https://site.ludo.test (ne pas inventer le domaine de production).
PUBLIC_SITE_ORIGIN=

# Uniquement pour tester localement la chaîne `build:launch` avec des origines .test.
# Cette fixture est vide et ne valide aucun contenu métier.
PUBLIC_LAUNCH_FIXTURE_MODE=
